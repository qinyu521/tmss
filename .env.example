# 天命史书 API 配置（复制为 .env 后按需修改；不要提交真实密钥）
PORT=8787
HOST=127.0.0.1
# 默认只监听本机回环；Docker Compose 会在容器内显式覆盖为 0.0.0.0。
# 不要为了公网访问把宿主机端口直接映射到 0.0.0.0。
# 反向代理头默认不可信。只有 origin 只能经单一可信代理访问时，才设置 TRUST_PROXY=1。
TRUST_PROXY=0
# SQLite 数据库路径（相对仓库根目录），生产环境挂载到持久化卷
TIANMING_DB=data/runtime/tianming.db
# 允许跨域来源，多个用逗号分隔；开发默认放行 Vite
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# 静态前端目录（单容器一体化部署时由 API 托管）
SERVE_WEB=1
# 可选外部 LLM 史官（OpenAI 兼容 Chat Completions）：默认关闭。
# LLM_PROVIDER 或 LLM_API_KEY 留空即未启用，游戏使用本地模板史官，完整可玩，不发起任何外部请求。
# LLM 只读史官条目事实层与事件摘要，仅回写文学润色/推断表达层，绝不改写事实与世界状态。
LLM_PROVIDER=
LLM_API_KEY=
# OpenAI 兼容接口地址（不含 /chat/completions），默认 https://api.openai.com/v1
LLM_BASE_URL=
# 模型名，默认 gpt-4o-mini
LLM_MODEL=
# 请求超时毫秒数，默认 20000
LLM_TIMEOUT_MS=
# 单机/个人部署模式（无多用户认证）；设为 0 会拒绝启动，直到实现用户认证与存档隔离。
SINGLE_PLAYER_MODE=1
