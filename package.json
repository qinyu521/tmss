{
  "name": "tianming-shishu",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @tianming/api\" \"npm run dev -w @tianming/web\"",
    "dev:api": "npm run dev -w @tianming/api",
    "dev:web": "npm run dev -w @tianming/web",
    "build": "npm run build -w @tianming/web && npm run typecheck",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:seed": "tsx scripts/validate-seed.ts",
    "import:seed": "tsx scripts/import-seed.ts",
    "assets": "node scripts/generate-portraits.mjs && node scripts/generate-unit-icons.mjs",
    "start": "npm run start -w @tianming/api",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:browser": "node scripts/smoke-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "playwright": "^1.64.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
